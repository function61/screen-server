{
	"for_description_of_this_file_see": "https://github.com/function61/turbobob",
	"version_major": 1,
	"project_name": "screen-server",
	"project_emoji_icon": "🖥️",
	"builders": [
		{
			"name": "default",
			"uses": "docker://fn61/buildkit-golang:20251124_1405_720e0dc0",
			"mount_destination": "/workspace",
			"workdir": "/workspace",
			"commands": {
				"build": ["build-go-project.sh", "--directory=cmd/screen-server/", "--binary-basename=screen-server"],
				"dev": ["bash"]
			}
		}
	],
	"os_arches": {
		"linux-amd64": true,
		"linux-arm64": true,
		"linux-arm": true
	},
	"docker_images": [
		{
			"image": "fn61/screen-server",
			"dockerfile_path": "Dockerfile",
			"platforms": ["linux/amd64", "linux/arm64", "linux/arm/v7"]
		}
	]
}
